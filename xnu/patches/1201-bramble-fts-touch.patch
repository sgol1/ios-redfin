+/*
+ * bramble (b7): read a synchronized MS strength frame (Google's getSyncFrame(LOAD_SYNC_FRAME_STRENGTH),
+ * redbull fts_lib ftsCore.c requestSyncFrame + ftsFrame.c readSyncDataHeader): framebuffer reads are
+ * A7 <addr16> + 1 dummy byte over SPI. Logs the frame size, the strongest node and how many nodes are
+ * above 100, to tell "the sensor sees the finger" from "it sees nothing".
+ */
+static int
+fts_fb_read(uint16_t addr, uint8_t *out, unsigned n)
+{
+	uint8_t buf[64] = {0xa7, (uint8_t)(addr >> 8), (uint8_t)addr};
+	if (n > sizeof(buf) - 4u) {
+		return EINVAL;
+	}
+	int err = fts_xfer(buf, 4u + n);
+	if (!err) {
+		memcpy(out, buf + 4, n);
+	}
+	return err;
+}
+
+/*
+ * bramble (b8): frame touch. b7's strength frames: background 10..57, a finger in the middle ~190..300,
+ * but the firmware reported no event. flametouchframe=1: read the strength frame ~30 times a second,
+ * and when its strongest node is above flametouchthr (150) report one finger at the 3x3 weighted
+ * centroid around it (sense axis 32 = the long one = y, force axis 15 = x; flametouchrot bits 0/1
+ * mirror x/y if a test shows them reversed).
+ */
+static int16_t fts_frame[15 * 32 + 64];
+static unsigned fts_frame_f, fts_frame_s;
+
+static int
+fts_frame_read(void)
+{
+	uint8_t h[16];
+	if (fts_fb_read(0, h, 4)) {
+		return EIO;
+	}
+	unsigned count = h[2] | (h[3] << 8), now = count;
+	uint8_t pre[7] = {FTS_CMD_HW_W, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00};
+	uint8_t req[3] = {0xa4, 0x06, 0x33};
+	if (fts_xfer(pre, sizeof(pre)) || fts_xfer(req, sizeof(req))) {
+		return EIO;
+	}
+	for (unsigned t = 0; t < 40 && now == count; ++t) {
+		delay(500);
+		if (!fts_fb_read(0, h, 4) && h[0] == 0xa5 && h[1] == 0x33) {
+			now = h[2] | (h[3] << 8);
+		}
+	}
+	if (now == count || fts_fb_read(0, h, sizeof(h)) || h[0] != 0xa5 || h[1] != 0x33) {
+		return ETIMEDOUT;
+	}
+	unsigned f = h[5], s = h[6], nodes = f * s;
+	if (!f || !s || nodes > sizeof(fts_frame) / sizeof(fts_frame[0])) {
+		return EINVAL;
+	}
+	uint16_t addr = (uint16_t)(16u + h[4]);
+	uint8_t chunk[60];
+	for (unsigned done = 0; done < nodes * 2u; ) {
+		unsigned n = MIN(sizeof(chunk), nodes * 2u - done);
+		if (fts_fb_read((uint16_t)(addr + done), chunk, n)) {
+			return EIO;
+		}
+		for (unsigned i = 0; i + 1 < n; i += 2) {
+			fts_frame[(done + i) / 2u] = (int16_t)(chunk[i] | (chunk[i + 1] << 8));
+		}
+		done += n;
+	}
+	fts_frame_f = f;
+	fts_frame_s = s;
+	return 0;
+}
+
+static bool fts_frame_down;
+/* b10: sense columns to ignore (b9: all 3937 detections were sense 16 noise bursts), and the
+ * minimum number of nodes in the 3x3 that rise at least thr/2 (a fingertip spans several nodes) */
+static unsigned fts_frame_mask = 1u << 16, fts_frame_min = 3;
+static int fts_peak_v, fts_peak_f, fts_peak_s;
+static unsigned fts_peak_n;
+static int fts_frame_x, fts_frame_y;
+
+static void
+fts_frame_touch(int thr, unsigned rot)
+{
+	if (fts_frame_read()) {
+		return;
+	}
+	unsigned f = fts_frame_f, s = fts_frame_s, best = 0, n = f * s;
+	/*
+	 * b9: per-node baseline. b8's peaks were always sense column 16 (a column that reads high with
+	 * nobody touching; glove mode lifted it to 150..528), so raw peaks reported phantom touches on the
+	 * screen's middle line. The first 32 frames set each node's idle level (x16 fixed point); after that
+	 * a touch is a node more than thr above its own level, and with no touch the levels follow drift.
+	 */
+	static int32_t base16[sizeof(fts_frame) / sizeof(fts_frame[0])];
+	static unsigned base_frames;
+	if (base_frames < 32) {
+		for (unsigned i = 0; i < n; ++i) {
+			base16[i] = base_frames ? base16[i] + ((fts_frame[i] * 16 - base16[i]) / (int32_t)(base_frames + 1))
+			                        : fts_frame[i] * 16;
+		}
+		if (++base_frames == 32) {
+			int bmax = 0;
+			unsigned bi = 0;
+			for (unsigned i = 0; i < n; ++i) {
+				if (base16[i] > bmax) {
+					bmax = base16[i];
+					bi = i;
+				}
+			}
+			printf("SWEET FTS: frame baseline set: highest idle node %d at %u/%u\n", bmax / 16, bi / s, bi % s);
+		}
+		return;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		unsigned c = i % s;
+		if (c < 32 && (fts_frame_mask & (1u << c))) {
+			fts_frame[i] = (int16_t)(base16[i] / 16);   /* masked column: no rise */
+		}
+	}
+	int maxv = 0;
+	for (unsigned i = 0; i < n; ++i) {
+		int d = fts_frame[i] - base16[i] / 16;
+		if (d > maxv) {
+			maxv = d;
+			best = i;
+		}
+	}
+	unsigned blob = 0;
+	for (int df = -1; df <= 1; ++df) {
+		for (int ds = -1; ds <= 1; ++ds) {
+			int ff = (int)(best / s) + df, ss = (int)(best % s) + ds;
+			if (ff >= 0 && ss >= 0 && ff < (int)f && ss < (int)s &&
+			    2 * (fts_frame[ff * (int)s + ss] - base16[ff * (int)s + ss] / 16) >= thr) {
+				blob++;
+			}
+		}
+	}
+	if (maxv > fts_peak_v) {
+		fts_peak_v = maxv;
+		fts_peak_f = (int)(best / s);
+		fts_peak_s = (int)(best % s);
+		fts_peak_n = blob;
+	}
+	if (maxv < thr || blob < fts_frame_min) {
+		for (unsigned i = 0; i < n; ++i) {
+			base16[i] += (fts_frame[i] * 16 - base16[i]) / 32;
+		}
+		if (fts_frame_down) {
+			fts_frame_down = false;
+			sweet_hid_touch(0, 0, fts_frame_x, fts_frame_y);
+		}
+		return;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		fts_frame[i] = (int16_t)(fts_frame[i] - base16[i] / 16);   /* centroid on the rise above baseline */
+	}
+	int bf = (int)(best / s), bs = (int)(best % s);
+	long wsum = 0, wf = 0, ws = 0;
+	for (int df = -1; df <= 1; ++df) {
+		for (int ds = -1; ds <= 1; ++ds) {
+			int ff = bf + df, ss = bs + ds;
+			if (ff < 0 || ss < 0 || ff >= (int)f || ss >= (int)s) {
+				continue;
+			}
+			int v = fts_frame[ff * (int)s + ss];
+			if (v <= 0) {
+				continue;
+			}
+			wsum += v;
+			wf += (long)v * (2 * ff + 1);
+			ws += (long)v * (2 * ss + 1);
+		}
+	}
+	if (wsum <= 0) {
+		return;
+	}
+	int x = (int)(wf * 1080 / (wsum * 2 * (long)f));
+	int y = (int)(ws * 2340 / (wsum * 2 * (long)s));
+	if (rot & 1u) {
+		x = 1079 - x;
+	}
+	if (rot & 2u) {
+		y = 2339 - y;
+	}
+	x = MAX(0, MIN(1079, x));
+	y = MAX(0, MIN(2339, y));
+	fts_frame_x = x;
+	fts_frame_y = y;
+	if (!fts_frame_down && ft.log) {
+		printf("SWEET FTS: frame touch down %d,%d (max %d at %d/%d, %u nodes)\n", x, y, maxv, bf, bs, blob);
+	}
+	fts_frame_down = true;
+	sweet_hid_touch(0, 1, x, y);
+}
+
+static void
+fts_strength_probe(void)
+{
+	uint8_t h[16];
+	if (fts_fb_read(0, h, 4)) {
+		printf("SWEET FTS: strength: header read failed\n");
+		return;
+	}
+	unsigned count = h[2] | (h[3] << 8), now = count;
+	uint8_t pre[7] = {FTS_CMD_HW_W, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00};
+	uint8_t req[3] = {0xa4, 0x06, 0x33};     /* FTS_CMD_SYSTEM, SYS_CMD_LOAD_DATA, LOAD_SYNC_FRAME_STRENGTH */
+	if (fts_xfer(pre, sizeof(pre)) || fts_xfer(req, sizeof(req))) {
+		printf("SWEET FTS: strength: request failed\n");
+		return;
+	}
+	for (unsigned t = 0; t < 100 && now == count; ++t) {
+		fts_wait(5);
+		if (!fts_fb_read(0, h, 4) && h[0] == 0xa5 && h[1] == 0x33) {
+			now = h[2] | (h[3] << 8);
+		}
+	}
+	if (now == count || fts_fb_read(0, h, sizeof(h)) || h[0] != 0xa5 || h[1] != 0x33) {
+		printf("SWEET FTS: strength: no frame (sig %02x type %02x count %u->%u)\n", h[0], h[1], count, now);
+		return;
+	}
+	unsigned force = h[5], sense = h[6], nodes = force * sense, over = 0, maxi = 0;
+	int maxv = 0;
+	uint16_t addr = (uint16_t)(16u + h[4]);
+	uint8_t chunk[60];
+	for (unsigned done = 0; done < nodes * 2u && nodes <= 4096u; ) {
+		unsigned n = MIN(sizeof(chunk), nodes * 2u - done);
+		if (fts_fb_read((uint16_t)(addr + done), chunk, n)) {
+			printf("SWEET FTS: strength: data read failed at %u\n", done);
+			return;
+		}
+		for (unsigned i = 0; i + 1 < n; i += 2) {
+			int v = (int16_t)(chunk[i] | (chunk[i + 1] << 8));
+			int a = v < 0 ? -v : v;
+			if (a > maxv) {
+				maxv = a;
+				maxi = (done + i) / 2u;
+			}
+			over += a > 100;
+		}
+		done += n;
+	}
+	printf("SWEET FTS: strength %ux%u: max %d at force %u sense %u, nodes > 100: %u\n",
+	    force, sense, maxv, sense ? maxi / sense : 0, sense ? maxi % sense : 0, over);
+}
