 	bool           dsiDcs(const uint8_t *payload, uint32_t len);
 	void           blSet(uint32_t level);
 	static void    blLoop(void *arg);
+	/*
+	 * 1203 (bramble): panel sleep on display off (sweetpanelsleep, default on). The blLoop thread sends
+	 * DCS 28 (display off) + 10 (sleep in) once the off fade is black, and 11 (sleep out) + 29 (display on)
+	 * at power on, through the same command DMA as brightness (one DSI command at a time, between frames).
+	 */
+	uint32_t       fPanelWant;      /* 0 nothing, 1 sleep, 2 wake */
+	bool           fPanelAsleep;
+	bool           fPanelSleepOn;
+	uint32_t       fPanelAR;        /* autorefresh saved at sleep in */
+	void           panelReq(bool sleep);
+	bool           dcsShort(uint8_t cmd);
 	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
 	using IOMobileFramebuffer::copyProperty;
 	OSPtr<OSObject> copyProperty(const char *aKey) const APPLE_KEXT_OVERRIDE;      /* 1099: kern.sweet_bl_trace */
@@ -805,8 +816,34 @@ AppleCLCD::blLoop(void *arg)
 			IOLockSleep(fb->fBlLock, &fb->fBlReq, THREAD_UNINT);
 		}
 		fb->fBlReq = false;
-		uint32_t want = fb->fBlWant;
+		uint32_t want = fb->fBlWant, pw = fb->fPanelWant;
+		fb->fPanelWant = 0;
 		IOLockUnlock(fb->fBlLock);
+		if (pw == 1 && !fb->fPanelAsleep) {             /* 1203: sleep in */
+			uint32_t ar = sweet_mdp_rd(SWEET_INTF1 + INTF_TEAR_AUTOREFRESH);
+			if (ar >> 31) {
+				fb->fPanelAR = ar;              /* pause autorefresh: a sleeping panel sends no TE */
+				sweet_mdp_wr(SWEET_INTF1 + INTF_TEAR_AUTOREFRESH, 0);
+				IODelay(30000);
+			}
+			bool a = fb->dcsShort(0x28);
+			IODelay(20000);
+			bool b = fb->dcsShort(0x10);
+			IODelay(120000);
+			fb->fPanelAsleep = true;
+			printf("SWEET PANEL: sleep in (28 %d, 10 %d)\n", a, b);
+		} else if (pw == 2 && fb->fPanelAsleep) {       /* 1203: sleep out */
+			bool a = fb->dcsShort(0x11);
+			IODelay(120000);
+			bool b = fb->dcsShort(0x29);
+			IODelay(20000);
+			if (fb->fPanelAR >> 31) {
+				sweet_mdp_wr(SWEET_INTF1 + INTF_TEAR_AUTOREFRESH, fb->fPanelAR);
+			}
+			fb->fPanelAsleep = false;
+			fb->fBlHave = 0;                        /* send the level again */
+			printf("SWEET PANEL: sleep out (11 %d, 29 %d)\n", a, b);
+		}
 		if (want == fb->fBlHave || fb->fBlFails >= 3) {
 			continue;
 		}
