+/* 1203: DCS short write, no parameter (data type 05, last) */
+bool
+AppleCLCD::dcsShort(uint8_t cmd)
+{
+	if (cmd != 0x28 && cmd != 0x10 && cmd != 0x11 && cmd != 0x29) {
+		return false;
+	}
+	const uint8_t pkt[4] = { cmd, 0x00, 0x05, 0x80 };
+	return dsiSend(pkt, sizeof(pkt));
+}
+
+void
+AppleCLCD::panelReq(bool sleep)
+{
+	if (fBlLock == NULL || !fPanelSleepOn) {
+		return;
+	}
+	IOLockLock(fBlLock);
+	fPanelWant = sleep ? 1 : 2;
+	fBlReq = true;
+	IOLockWakeup(fBlLock, &fBlReq, false);
+	IOLockUnlock(fBlLock);
+}
